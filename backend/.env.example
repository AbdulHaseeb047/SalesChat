# Local development — use local PostgreSQL (recommended).
# Example:
#   createdb pos_dev
#   DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pos_dev"
#
# Do NOT use Supabase transaction pooler (:6543) — it breaks Prisma transactions + RLS session vars.
# Production: use direct Postgres or session-mode pooler (:5432), never transaction pooler.
DATABASE_URL="postgresql://postgres:password@localhost:5432/pos_dev"
# Keep the Prisma pool bounded for hosted session poolers. Override when your database allows more.
PRISMA_CONNECTION_LIMIT=5

# Auth — use long random secrets in production (>= 32 chars)
JWT_SECRET="local-dev-jwt-secret-min-32-chars-ok"
JWT_REFRESH_SECRET="local-dev-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Deployment
DEPLOYMENT_MODE="offline"
TENANT_ID=""

# Soft-lock upgrade CTA (WhatsApp). Override without code changes.
# UPGRADE_WHATSAPP_URL="https://wa.me/923462734539?text=Hi%2C%20I%27d%20like%20to%20upgrade%20my%20SaleChat%20POS%20plan"

# Server
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"

# Production only — must include your frontend origin or the browser blocks API calls
# CORS_ORIGINS="https://your-app.vercel.app"
# TRUST_PROXY=true

# Optional: set ENABLE_RLS_SESSION=true only if using FORCE RLS with a non-owner DB role.
# Leave unset/false on Railway — session SETs add latency per request.

# SMTP for support queries (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SUPPORT_INBOX_EMAIL=

# Hybrid / cloud sync (optional)
# SYNC_CLOUD_URL=
# SYNC_API_KEY=
# SYNC_DEVICE_ID=
# SYNC_INTERVAL_MS=30000
# SYNC_BATCH_SIZE=50
# SYNC_MAX_FAILED_RETRIES=5
