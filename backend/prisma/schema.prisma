// Prisma schema — Build Step 2: Auth, RBAC, tenant model
// Full domain models (billing, inventory, udhaar) added in Step 3.
// Table definitions: docs/SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  STAFF
}

enum TenantTier {
  STARTER
  STANDARD
  PRO
}

enum TenantFeeStatus {
  TRIAL
  ACTIVE
  OVERDUE
  SUSPENDED
}

enum SupportQueryStatus {
  OPEN
  CLOSED
}

// ---------------------------------------------------------------------------
// Tenancy & Auth
// ---------------------------------------------------------------------------

model Tenant {
  id                  String          @id @default(uuid()) @db.Uuid
  name                String          @db.VarChar(255)
  slug                String          @unique @db.VarChar(100)
  tier                TenantTier      @default(STARTER)
  /// Plan features granted while feeStatus=TRIAL and subscription window is open.
  trialPlanTier       TenantTier?     @map("trial_plan_tier")
  isActive            Boolean         @default(true) @map("is_active")
  feeStatus           TenantFeeStatus @default(TRIAL) @map("fee_status")
  monthlyFee          Decimal?        @map("monthly_fee") @db.Decimal(12, 2)
  feeDueDate          DateTime?       @map("fee_due_date") @db.Date
  acquiredById        String?         @map("acquired_by_id") @db.Uuid
  subscriptionStartAt DateTime?       @map("subscription_start_at") @db.Timestamptz(6)
  subscriptionEndsAt  DateTime?       @map("subscription_ends_at") @db.Timestamptz(6)
  subscriptionDays    Int             @default(30) @map("subscription_days")
  accessRevokedAt     DateTime?       @map("access_revoked_at") @db.Timestamptz(6)
  accessRevokeReason  String?         @map("access_revoke_reason") @db.VarChar(500)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?       @map("deleted_at") @db.Timestamptz(6)

  users              User[]
  tenantFeatures     TenantFeature[]
  licenseActivations LicenseActivation[]
  auditLogs          AuditLog[]
  categories         Category[]
  shopParts          ShopPart[]
  products           Product[]
  batches            Batch[]
  brands             Brand[]
  suppliers          Supplier[]
  heldCarts          HeldCart[]
  giftCards          GiftCard[]
  saleReturns        SaleReturn[]
  customers          Customer[]
  discountRules      DiscountRule[]
  sales              Sale[]
  businessSettings   BusinessSettings?
  saleSequences      SaleSequence?
  branches           Branch[]
  syncOutbox         SyncOutbox[]
  syncState          SyncState?
  syncChangelog      SyncChangelog[]
  syncDevices        SyncDevice[]
  supportQueries     SupportQuery[]
  acquiredBy         User?               @relation("TenantAcquiredBy", fields: [acquiredById], references: [id])

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String?   @map("tenant_id") @db.Uuid
  email              String    @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  fullName           String    @map("full_name") @db.VarChar(255)
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  isSalesRep         Boolean   @default(false) @map("is_sales_rep")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  branchId      String?        @map("branch_id") @db.Uuid
  branch        Branch?        @relation(fields: [branchId], references: [id])
  refreshTokens RefreshToken[]
  staffFeatures StaffFeature[]

  tenantFeaturesEnabled TenantFeature[]       @relation("TenantFeatureEnabledBy")
  staffFeaturesGranted  StaffFeature[]        @relation("StaffFeatureGrantedBy")
  auditLogs             AuditLog[]
  salesAsCashier        Sale[]                @relation("SaleCashier")
  salesVoided           Sale[]                @relation("SaleVoidedBy")
  stockMovements        StockMovement[]
  batchesCreated        Batch[]               @relation("BatchCreatedBy")
  ledgerEntries         CustomerLedgerEntry[] @relation("LedgerRecordedBy")
  ledgerVoided          CustomerLedgerEntry[] @relation("LedgerVoidedBy")
  supplierLedgerEntries SupplierLedgerEntry[] @relation("SupplierLedgerRecordedBy")
  heldCarts             HeldCart[]
  tenantsAcquired       Tenant[]              @relation("TenantAcquiredBy")
  supportQueries        SupportQuery[]

  @@map("users")
}

model SupportQuery {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  topic     String             @db.VarChar(80)
  subject   String             @db.VarChar(200)
  message   String             @db.Text
  status    SupportQueryStatus @default(OPEN)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("support_queries")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Permissions & Feature Flags
// ---------------------------------------------------------------------------

model FeatureRegistry {
  key         String  @id @db.VarChar(100)
  module      String  @db.VarChar(50)
  label       String  @db.VarChar(255)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  tenantFeatures TenantFeature[]
  staffFeatures  StaffFeature[]
  tierPresets    TierPreset[]

  @@map("feature_registry")
}

model TenantFeature {
  tenantId    String   @map("tenant_id") @db.Uuid
  featureKey  String   @map("feature_key") @db.VarChar(100)
  enabledAt   DateTime @default(now()) @map("enabled_at") @db.Timestamptz(6)
  enabledById String?  @map("enabled_by") @db.Uuid

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature   FeatureRegistry @relation(fields: [featureKey], references: [key])
  enabledBy User?           @relation("TenantFeatureEnabledBy", fields: [enabledById], references: [id])

  @@id([tenantId, featureKey])
  @@map("tenant_features")
}

model StaffFeature {
  userId      String   @map("user_id") @db.Uuid
  featureKey  String   @map("feature_key") @db.VarChar(100)
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  grantedById String   @map("granted_by") @db.Uuid

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   FeatureRegistry @relation(fields: [featureKey], references: [key])
  grantedBy User            @relation("StaffFeatureGrantedBy", fields: [grantedById], references: [id])

  @@id([userId, featureKey])
  @@map("staff_features")
}

model TierPreset {
  tier       TenantTier @map("tier")
  featureKey String     @map("feature_key") @db.VarChar(100)

  feature FeatureRegistry @relation(fields: [featureKey], references: [key])

  @@id([tier, featureKey])
  @@map("tier_presets")
}

model LicenseActivation {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  licenseKeyHash      String    @map("license_key_hash") @db.VarChar(255)
  hardwareFingerprint String    @map("hardware_fingerprint") @db.VarChar(255)
  featuresSnapshot    Json      @map("features_snapshot")
  activatedAt         DateTime  @default(now()) @map("activated_at") @db.Timestamptz(6)
  lastValidatedAt     DateTime? @map("last_validated_at") @db.Timestamptz(6)
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("license_activations")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Step 3: Inventory, Billing, Customers (Udhaar), Settings
// ---------------------------------------------------------------------------

enum StockMovementType {
  SALE
  RETURN
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

enum LedgerEntryType {
  CREDIT_SALE
  PAYMENT
  ADJUSTMENT
  OPENING_BALANCE
  VOID_REVERSAL
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum DiscountAppliesTo {
  ITEM
  BILL
}

enum SupplierLedgerEntryType {
  PURCHASE
  PAYMENT
  ADJUSTMENT
}

enum FinancialEntryType {
  INCOME
  INVENTORY_PURCHASE
  BUSINESS_EXPENSE
  PERSONAL_EXPENSE
  HOME_EXPENSE
  OWNER_WITHDRAWAL
  OWNER_INVESTMENT
  REINVESTMENT
  REFUND
  ADJUSTMENT
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum SalePaymentStatus {
  PAID
  ON_CREDIT
  PARTIAL
}

enum SalePaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CREDIT
  GIFT_CARD
}

/// SIMPLE = ordinary spare parts (product-level stock).
/// BATCH = fractional bulk (gas/pipe) tracked per cylinder/coil.
enum ProductTrackType {
  SIMPLE
  BATCH
}

enum BatchStatus {
  WAREHOUSE
  OPEN
  CLOSED
  DAMAGED
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
  @@map("categories")
}

/// Logical business division within one shop (separate P&L / purchase tracking).
model ShopPart {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  products  Product[]
  saleItems SaleItem[]

  @@index([tenantId])
  @@map("shop_parts")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
  @@map("brands")
}

model Supplier {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  phone     String?   @db.VarChar(20)
  email     String?   @db.VarChar(255)
  address   String?   @db.Text
  notes     String?   @db.Text
  balance   Decimal   @default(0) @db.Decimal(12, 2)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  products      Product[]
  ledgerEntries SupplierLedgerEntry[]

  @@index([tenantId])
  @@map("suppliers")
}

model SupplierLedgerEntry {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  supplierId    String                  @map("supplier_id") @db.Uuid
  entryType     SupplierLedgerEntryType @map("entry_type")
  amount        Decimal                 @db.Decimal(12, 2)
  balanceAfter  Decimal                 @map("balance_after") @db.Decimal(12, 2)
  referenceType String?                 @map("reference_type") @db.VarChar(50)
  referenceId   String?                 @map("reference_id") @db.Uuid
  paymentMethod String?                 @map("payment_method") @db.VarChar(50)
  notes         String?                 @db.Text
  recordedById  String                  @map("recorded_by") @db.Uuid
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier   Supplier @relation(fields: [supplierId], references: [id])
  recordedBy User     @relation("SupplierLedgerRecordedBy", fields: [recordedById], references: [id])

  @@index([tenantId, supplierId, createdAt])
  @@map("supplier_ledger_entries")
}

model Product {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  categoryId             String?          @map("category_id") @db.Uuid
  partId                 String?          @map("part_id") @db.Uuid
  brandId                String?          @map("brand_id") @db.Uuid
  supplierId             String?          @map("supplier_id") @db.Uuid
  name                   String           @db.VarChar(255)
  sku                    String?          @db.VarChar(100)
  barcode                String?          @db.VarChar(100)
  imageUrl               String?          @map("image_url") @db.Text
  /// Display / sale unit (kg, meter, feet, piece). Acts as sale_unit from the plan.
  unit                   String           @default("piece") @db.VarChar(50)
  costPrice              Decimal?         @map("cost_price") @db.Decimal(12, 2)
  /// Editable daily rate (price_per_unit). Override allowed on the sale line via unit_price.
  sellPrice              Decimal          @map("sell_price") @db.Decimal(12, 2)
  /// Fixed total price for selling an entire warehouse batch (not per-unit).
  batchSellPrice         Decimal?         @map("batch_sell_price") @db.Decimal(12, 2)
  taxRate                Decimal          @default(0) @map("tax_rate") @db.Decimal(5, 2)
  stockQuantity          Decimal          @default(0) @map("stock_quantity") @db.Decimal(12, 3)
  lowStockThreshold      Decimal?         @map("low_stock_threshold") @db.Decimal(12, 3)
  targetStock            Decimal          @default(0) @map("target_stock") @db.Decimal(12, 3)
  expiryDate             DateTime?        @map("expiry_date") @db.Date
  trackStock             Boolean          @default(true) @map("track_stock")
  trackType              ProductTrackType @default(SIMPLE) @map("track_type")
  /// Deprecated: was per-sale hose loss %. Gas loss is recorded at cylinder close-out.
  dispensingLossPercent  Decimal          @default(0) @map("dispensing_loss_percent") @db.Decimal(5, 2)
  isActive               Boolean          @default(true) @map("is_active")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?        @map("deleted_at") @db.Timestamptz(6)
  version                Int              @default(1)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  part           ShopPart?       @relation(fields: [partId], references: [id])
  brand          Brand?          @relation(fields: [brandId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  batches        Batch[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, categoryId])
  @@index([tenantId, partId])
  @@index([tenantId, brandId])
  @@index([tenantId, supplierId])
  @@index([tenantId, trackType])
  @@map("products")
}

/// One physical cylinder/coil (or similar) for a batch-tracked product.
model Batch {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  productId         String      @map("product_id") @db.Uuid
  purchaseDate      DateTime    @map("purchase_date") @db.Date
  supplier          String?     @db.VarChar(255)
  purchaseReference String?     @map("purchase_reference") @db.VarChar(100)
  costPerUnit       Decimal     @map("cost_per_unit") @db.Decimal(12, 4)
  initialQuantity   Decimal     @map("initial_quantity") @db.Decimal(12, 3)
  remainingQuantity Decimal     @map("remaining_quantity") @db.Decimal(12, 3)
  /// WAREHOUSE = full unit in store; OPEN = on counter for loose sales; CLOSED/DAMAGED = done.
  status            BatchStatus @default(WAREHOUSE)
  notes             String?     @db.Text
  /// When the cylinder was finalized via gas-loss close-out.
  closedAt          DateTime?   @map("closed_at") @db.Timestamptz(6)
  /// Remaining gas written off at close-out (qty).
  gasLossQuantity   Decimal?    @map("gas_loss_quantity") @db.Decimal(12, 3)
  /// gas_loss_quantity × cost_per_unit at close-out.
  gasLossCost       Decimal?    @map("gas_loss_cost") @db.Decimal(12, 4)
  createdById       String?     @map("created_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  createdBy      User?           @relation("BatchCreatedBy", fields: [createdById], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([tenantId, productId, status])
  @@index([tenantId, status, purchaseDate])
  @@map("batches")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  productId     String            @map("product_id") @db.Uuid
  batchId       String?           @map("batch_id") @db.Uuid
  movementType  StockMovementType @map("movement_type")
  quantityDelta Decimal           @map("quantity_delta") @db.Decimal(12, 3)
  quantityAfter Decimal           @map("quantity_after") @db.Decimal(12, 3)
  referenceType String?           @map("reference_type") @db.VarChar(50)
  referenceId   String?           @map("reference_id") @db.Uuid
  notes         String?           @db.Text
  recordedById  String            @map("recorded_by") @db.Uuid
  branchId      String?           @map("branch_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product @relation(fields: [productId], references: [id])
  batch      Batch?  @relation(fields: [batchId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])
  branch     Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, batchId, createdAt])
  @@map("stock_movements")
}

model Customer {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  name        String    @db.VarChar(255)
  phone       String?   @db.VarChar(20)
  email       String?   @db.VarChar(255)
  address     String?   @db.Text
  creditLimit Decimal?  @map("credit_limit") @db.Decimal(12, 2)
  balance     Decimal   @default(0) @db.Decimal(12, 2)
  notes       String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  version     Int       @default(1)

  tenant        Tenant                     @relation(fields: [tenantId], references: [id])
  ledgerEntries CustomerLedgerEntry[]
  obligations   CustomerCreditObligation[]
  sales         Sale[]

  @@index([tenantId])
  @@map("customers")
}

model CustomerLedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  entryType     LedgerEntryType @map("entry_type")
  amount        Decimal         @db.Decimal(12, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(12, 2)
  saleId        String?         @map("sale_id") @db.Uuid
  paymentMethod String?         @map("payment_method") @db.VarChar(50)
  notes         String?         @db.Text
  recordedById  String          @map("recorded_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt      DateTime?       @map("voided_at") @db.Timestamptz(6)
  voidedById    String?         @map("voided_by") @db.Uuid
  voidReason    String?         @map("void_reason") @db.Text
  reversalOfId  String?         @map("reversal_of_id") @db.Uuid
  version       Int             @default(1)

  customer    Customer                    @relation(fields: [customerId], references: [id])
  sale        Sale?                       @relation(fields: [saleId], references: [id])
  recordedBy  User                        @relation("LedgerRecordedBy", fields: [recordedById], references: [id])
  voidedBy    User?                       @relation("LedgerVoidedBy", fields: [voidedById], references: [id])
  reversalOf  CustomerLedgerEntry?        @relation("LedgerReversal", fields: [reversalOfId], references: [id])
  reversals   CustomerLedgerEntry[]       @relation("LedgerReversal")
  obligation  CustomerCreditObligation?
  allocations CustomerPaymentAllocation[]

  @@index([tenantId, customerId, createdAt])
  @@map("customer_ledger_entries")
}

model CustomerCreditObligation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  ledgerEntryId   String    @unique @map("ledger_entry_id") @db.Uuid
  saleId          String    @map("sale_id") @db.Uuid
  originalAmount  Decimal   @map("original_amount") @db.Decimal(12, 2)
  remainingAmount Decimal   @map("remaining_amount") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(6)
  version         Int       @default(1)

  customer    Customer                    @relation(fields: [customerId], references: [id])
  ledgerEntry CustomerLedgerEntry         @relation(fields: [ledgerEntryId], references: [id])
  sale        Sale                        @relation(fields: [saleId], references: [id])
  allocations CustomerPaymentAllocation[]

  @@index([tenantId, customerId, createdAt])
  @@map("customer_credit_obligations")
}

model CustomerPaymentAllocation {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  ledgerEntryId String   @map("ledger_entry_id") @db.Uuid
  obligationId  String   @map("obligation_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ledgerEntry CustomerLedgerEntry      @relation(fields: [ledgerEntryId], references: [id])
  obligation  CustomerCreditObligation @relation(fields: [obligationId], references: [id])

  @@index([ledgerEntryId])
  @@index([obligationId])
  @@map("customer_payment_allocations")
}

model FinancialEntry {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  entryType    FinancialEntryType @map("entry_type")
  amount       Decimal            @db.Decimal(12, 2)
  category     String             @db.VarChar(100)
  description  String?            @db.Text
  occurredAt   DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)
  recordedById String             @map("recorded_by") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  voidedAt     DateTime?          @map("voided_at") @db.Timestamptz(6)
  voidReason   String?            @map("void_reason") @db.Text
  version      Int                @default(1)

  @@index([tenantId, occurredAt])
  @@index([tenantId, entryType, occurredAt])
  @@map("financial_entries")
}

model DiscountRule {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  name          String            @db.VarChar(255)
  discountType  DiscountType      @map("discount_type")
  value         Decimal           @db.Decimal(12, 2)
  appliesTo     DiscountAppliesTo @map("applies_to")
  productId     String?           @map("product_id") @db.Uuid
  categoryId    String?           @map("category_id") @db.Uuid
  minBillAmount Decimal?          @map("min_bill_amount") @db.Decimal(12, 2)
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz(6)
  version       Int               @default(1)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  usages DiscountUsage[]

  @@index([tenantId])
  @@map("discount_rules")
}

model DiscountUsage {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  discountRuleId String   @map("discount_rule_id") @db.Uuid
  saleId         String   @map("sale_id") @db.Uuid
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  discountRule DiscountRule @relation(fields: [discountRuleId], references: [id])
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, discountRuleId])
  @@index([tenantId, saleId])
  @@map("discount_usages")
}

model Sale {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  saleNumber       String            @map("sale_number") @db.VarChar(50)
  status           SaleStatus        @default(COMPLETED)
  customerId       String?           @map("customer_id") @db.Uuid
  subtotal         Decimal           @db.Decimal(12, 2)
  discountTotal    Decimal           @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal         Decimal           @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal       Decimal           @map("grand_total") @db.Decimal(12, 2)
  paymentStatus    SalePaymentStatus @map("payment_status")
  notes            String?           @db.Text
  cashierId        String            @map("cashier_id") @db.Uuid
  branchId         String?           @map("branch_id") @db.Uuid
  voidedAt         DateTime?         @map("voided_at") @db.Timestamptz(6)
  voidedById       String?           @map("voided_by") @db.Uuid
  voidReason       String?           @map("void_reason") @db.Text
  fbrInvoiceNumber String?           @map("fbr_invoice_number") @db.VarChar(100)
  fbrQrData        String?           @map("fbr_qr_data") @db.Text
  amountReceived   Decimal?          @map("amount_received") @db.Decimal(12, 2)
  changeGiven      Decimal?          @map("change_given") @db.Decimal(12, 2)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int               @default(1)

  tenant         Tenant                     @relation(fields: [tenantId], references: [id])
  customer       Customer?                  @relation(fields: [customerId], references: [id])
  cashier        User                       @relation("SaleCashier", fields: [cashierId], references: [id])
  voidedBy       User?                      @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  branch         Branch?                    @relation(fields: [branchId], references: [id])
  items          SaleItem[]
  payments       SalePayment[]
  ledgerEntries  CustomerLedgerEntry[]
  obligations    CustomerCreditObligation[]
  returns        SaleReturn[]
  discountUsages DiscountUsage[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("sales")
}

model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  partId           String?  @map("part_id") @db.Uuid
  batchId          String?  @map("batch_id") @db.Uuid
  productName      String   @map("product_name") @db.VarChar(255)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// Quantity billed to the customer (quantity_sold).
  quantity         Decimal  @db.Decimal(12, 3)
  /// Quantity removed from batch/stock (includes dispensing loss when applicable).
  /// Null on legacy rows — treat as equal to quantity.
  quantityDeducted Decimal? @map("quantity_deducted") @db.Decimal(12, 3)
  /// Snapshot of batch.cost_per_unit (or product.cost_price) at sale time for historical margin.
  unitCostAtSale   Decimal? @map("unit_cost_at_sale") @db.Decimal(12, 4)
  discountAmount   Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount        Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  part    ShopPart? @relation(fields: [partId], references: [id])
  batch   Batch?   @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([partId])
  @@index([batchId])
  @@map("sale_items")
}

model SalePayment {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  saleId        String            @map("sale_id") @db.Uuid
  paymentMethod SalePaymentMethod @map("payment_method")
  amount        Decimal           @db.Decimal(12, 2)
  ledgerEntryId String?           @map("ledger_entry_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@map("sale_payments")
}

model HeldCart {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String?  @db.VarChar(255)
  cartData  Json     @map("cart_data") @db.JsonB
  cashierId String   @map("cashier_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  cashier User   @relation(fields: [cashierId], references: [id])

  @@index([tenantId, cashierId])
  @@map("held_carts")
}

model GiftCard {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  code           String    @db.VarChar(50)
  initialBalance Decimal   @map("initial_balance") @db.Decimal(12, 2)
  balance        Decimal   @db.Decimal(12, 2)
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("gift_cards")
}

model SaleReturn {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  saleId        String   @map("sale_id") @db.Uuid
  returnNumber  String   @map("return_number") @db.VarChar(50)
  reason        String   @db.Text
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  processedById String   @map("processed_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  sale   Sale             @relation(fields: [saleId], references: [id])
  items  SaleReturnItem[]

  @@index([tenantId, saleId])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  saleReturnId String  @map("sale_return_id") @db.Uuid
  saleItemId   String  @map("sale_item_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  productName  String  @map("product_name") @db.VarChar(255)
  quantity     Decimal @db.Decimal(12, 3)
  refundAmount Decimal @map("refund_amount") @db.Decimal(12, 2)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
  @@map("sale_return_items")
}

model SaleSequence {
  tenantId   String @id @map("tenant_id") @db.Uuid
  lastNumber BigInt @default(0) @map("last_number")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("sale_sequences")
}

model BusinessSettings {
  tenantId                String   @id @map("tenant_id") @db.Uuid
  businessName            String   @map("business_name") @db.VarChar(255)
  address                 String?  @db.Text
  phone                   String?  @db.VarChar(20)
  logoUrl                 String?  @map("logo_url") @db.Text
  currency                String   @default("PKR") @db.VarChar(3)
  taxLabel                String   @default("Tax") @map("tax_label") @db.VarChar(50)
  defaultTaxRate          Decimal  @default(0) @map("default_tax_rate") @db.Decimal(5, 2)
  printReceiptsDefault    Boolean  @default(false) @map("print_receipts_default")
  /// When true, open the on-screen receipt after a completed sale
  showReceiptAfterSale    Boolean  @default(true) @map("show_receipt_after_sale")
  receiptFooter           String?  @map("receipt_footer") @db.Text
  /// NAME | LOGO | BOTH — what to print at the top of receipts
  receiptHeaderMode       String   @default("NAME") @map("receipt_header_mode") @db.VarChar(20)
  maxDiscountPercentStaff Decimal? @map("max_discount_percent_staff") @db.Decimal(5, 2)
  fbrEnabled              Boolean  @default(false) @map("fbr_enabled")
  fbrPosId                String?  @map("fbr_pos_id") @db.VarChar(50)
  fbrStrn                 String?  @map("fbr_strn") @db.VarChar(50)
  fbrRegisteredName       String?  @map("fbr_registered_name") @db.VarChar(255)
  printerMode             String   @default("BROWSER") @map("printer_mode") @db.VarChar(20)
  printerHost             String?  @map("printer_host") @db.VarChar(255)
  printerPort             Int      @default(9100) @map("printer_port")
  printerPaperWidth       Int      @default(80) @map("printer_paper_width")
  /// Ordered product UUIDs for Sale Quick pick (Standard+ ui.customize)
  saleQuickPickIds        Json     @default("[]") @map("sale_quick_pick_ids")
  /// Dashboard widget visibility + order; null = built-in default
  dashboardLayout         Json?    @map("dashboard_layout")
  /// When remaining_quantity <= this, auto-close the batch (default 0.1).
  batchCloseTolerance     Decimal  @default(0.1) @map("batch_close_tolerance") @db.Decimal(12, 3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("business_settings")
}

// ---------------------------------------------------------------------------
// Step 4: Multi-branch
// ---------------------------------------------------------------------------

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @db.VarChar(50)
  address   String?   @db.Text
  phone     String?   @db.VarChar(20)
  isDefault Boolean   @default(false) @map("is_default")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  sales          Sale[]
  stockMovements StockMovement[]
  users          User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Step 5: Hybrid sync
// ---------------------------------------------------------------------------

enum SyncOperation {
  INSERT
  UPDATE
  DELETE
}

enum SyncOutboxStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

model SyncOutbox {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  tableName     String           @map("table_name") @db.VarChar(100)
  recordId      String           @map("record_id") @db.Uuid
  operation     SyncOperation
  payload       Json             @db.JsonB
  recordVersion Int              @map("record_version")
  status        SyncOutboxStatus @default(PENDING)
  retryCount    Int              @default(0) @map("retry_count")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  syncedAt      DateTime?        @map("synced_at") @db.Timestamptz(6)
  errorMessage  String?          @map("error_message") @db.Text

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, createdAt])
  @@map("sync_outbox")
}

model SyncState {
  tenantId     String    @id @map("tenant_id") @db.Uuid
  lastPulledAt DateTime? @map("last_pulled_at") @db.Timestamptz(6)
  lastPushedAt DateTime? @map("last_pushed_at") @db.Timestamptz(6)
  cloudCursor  String?   @map("cloud_cursor") @db.VarChar(255)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("sync_state")
}

model SyncChangelog {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tableName      String        @map("table_name") @db.VarChar(100)
  recordId       String        @map("record_id") @db.Uuid
  operation      SyncOperation
  payload        Json          @db.JsonB
  recordVersion  Int           @map("record_version")
  sourceDeviceId String?       @map("source_device_id") @db.VarChar(100)
  sourceOutboxId String?       @map("source_outbox_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt, id])
  @@map("sync_changelog")
}

model SyncDevice {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  deviceId   String    @map("device_id") @db.VarChar(100)
  label      String?   @db.VarChar(255)
  apiKeyHash String    @unique @map("api_key_hash") @db.VarChar(64)
  isActive   Boolean   @default(true) @map("is_active")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, deviceId])
  @@index([tenantId])
  @@map("sync_devices")
}
